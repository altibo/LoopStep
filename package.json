    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8"
  }
}
